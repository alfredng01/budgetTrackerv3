# Copy to .env and fill in. Never commit .env.

# The URL you open the app at (scheme + host + port). Cookies/CSRF checks depend on this.
# Behind a Cloudflare tunnel: the public hostname, e.g. https://budget.example.com
BETTER_AUTH_URL=http://localhost:3000
# Other origins that should be allowed, comma-separated (e.g. http://tower.local:3000,http://192.168.1.50:3000)
TRUSTED_ORIGINS=
# Only if a reverse proxy or Cloudflare tunnel sits in front: number of proxy hops (usually 1),
# or the proxy's IP/subnet (e.g. 172.17.0.0/16) if the app is also opened directly on the LAN
TRUST_PROXY=
# Where Sign up and Forgot password work: lan (not through the Cloudflare tunnel), everywhere, or off
SIGNUP_AND_RESET=lan
# 32+ random characters. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Read-only "see everything" account, created/updated on every startup.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Statement parsing (optional; without a key the upload feature is disabled).
ANTHROPIC_API_KEY=
STATEMENT_PARSER_MODEL=claude-sonnet-5-5

PORT=3000
DATABASE_PATH=./data/budget.db
# Category/card lists, edited from the Settings page (created from config/defaults.json on first start)
CONFIG_PATH=./data/config.json

# ---- Docker / Unraid (read by docker-compose.yml) ----
# Where the project source was copied to (folder containing the Dockerfile)
# SOURCE_DIR=/mnt/cache/appdata/budget-tracker/src
# Where budget.db and config.json live. Use a direct pool path, not /mnt/user, and never the flash drive.
# DATA_DIR=/mnt/cache/appdata/budget-tracker/data
# Host port (BETTER_AUTH_URL must use the same port)
# HOST_PORT=3000
# Unraid's nobody:users
# PUID=99
# PGID=100
